---
// Renders a blog post card.
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  difficulty: 'Easy' | 'Medium' | 'Hard' | 'Insane';
  tags: string[];
  pubDate: Date;
}

const { slug, title, description, category, difficulty, tags, pubDate } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const diffClass = `badge-diff-${difficulty.toLowerCase()}`;
---

<a href={`${base}/blog/${slug}`} class="post-card hud-frame">
  <div class="post-top">
    <span class={`badge ${diffClass}`}>{difficulty}</span>
  </div>
  <h3>{title}</h3>
  <p class="text-muted desc">{description}</p>
  <div class="post-meta">
    <span class="badge">{category}</span>
    {tags.slice(0, 3).map((t) => <span class="badge text-dim">#{t}</span>)}
  </div>
  <div class="post-footer mono text-dim">
    {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: inherit;
  }

  .post-card:hover {
    text-decoration: none;
  }

  .post-top {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .desc {
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .post-footer {
    font-size: 0.75rem;
    border-top: 1px solid var(--border-soft);
    padding-top: 0.75rem;
  }
</style>
