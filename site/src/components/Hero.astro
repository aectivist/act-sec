---

<section class="hero">
  <div class="container hero-inner">
    <div class="term-window">
      <div class="term-bar">
        <div class="term-dots">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
        </div>
        <span class="term-path mono">guest@{siteConfig.brand}:~$</span>
      </div>
      <div class="term-body">
        <pre class="ascii-emblem mono" aria-hidden="true">{asciiEmblem}</pre>
        <h1 class="sr-only">{siteConfig.name}</h1>
        <p class="mono kicker">// identity.init</p>
        <pre class="ascii-banner mono" aria-hidden="true">{asciiBanner}</pre>
        <div class="titles mono">
          {siteConfig.titles.map((t, i) => (
            <>
              <span>{t}</span>
              {i < siteConfig.titles.length - 1 && <span class="sep">/</span>}
            </>
          ))}
        </div>
        <p class="about">{siteConfig.about}</p>
        <div class="hero-actions">
          <a class="btn" href="#blog">Read the blog</a>
          <a class="btn" href={base + '/contact'}>Get in touch</a>
        </div>
      </div>
    </div>
  </div>
  <div class="scanline" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding: 6rem 0 3rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .term-body {
    position: relative;
    container-type: inline-size;
  }

  .ascii-emblem {
    position: absolute;
    top: 0;
    right: 0;
    margin: 0;
    font-size: 4px;
    line-height: 4px;
    color: var(--accent);
    opacity: 0.45;
    white-space: pre;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 700px) {
    .ascii-emblem {
      display: none;
    }
  }

  .kicker {
    color: var(--accent-soft);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .ascii-banner {
    margin: 0 0 1.5rem;
    /* vw-based fallback for browsers without container query units, no
       lower floor so it keeps shrinking rather than overflowing. */
    font-size: min(0.6vw, 6px);
    /* cqw sizes off the actual available width inside .term-body (which
       has fixed padding eating into it) rather than the raw viewport, so
       this stays accurate even at extreme zoom/narrow widths where vw
       badly overestimates the room actually available. */
    font-size: min(0.75cqw, 6px);
    line-height: 1.15;
    color: var(--accent);
    text-shadow: 0 0 12px var(--accent-glow);
    white-space: pre;
    overflow-x: auto;
    max-width: 100%;
  }

  .titles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--accent);
    font-size: 1rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .sep {
    color: var(--text-dim);
  }

  .about {
    max-width: 640px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .scanline {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--accent-glow) 50%,
      transparent 100%
    );
    opacity: 0.05;
    height: 200%;
    animation: scan 8s linear infinite;
  }

  @keyframes scan {
    0% { transform: translateY(-50%); }
    100% { transform: translateY(0%); }
  }
</style>
