---
interface Props {
  title: string;
  description: string;
  tags: string[];
  role?: string;
  dateRange?: string;
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
}

const { title, description, tags, role, dateRange, githubUrl, liveUrl, featured } = Astro.props;
const href = githubUrl || liveUrl;
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class="project-card hud-frame" {...linkProps}>
  {featured && <span class="badge badge-accent featured-badge">Featured</span>}
  <h3>{title}</h3>
  {(role || dateRange) && (
    <p class="mono meta text-dim">
      {role}{role && dateRange && ' · '}{dateRange}
    </p>
  )}
  <p class="text-muted desc">{description}</p>
  <div class="tags">
    {tags.map((t) => <span class="badge text-dim">#{t}</span>)}
  </div>
  {href && (
    <div class="links mono text-dim">
      {githubUrl ? '↳ view on github' : '↳ view live'}
    </div>
  )}
</Tag>

<style>
  .project-card {
    position: relative;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }

  a.project-card:hover {
    text-decoration: none;
  }

  .featured-badge {
    position: absolute;
    top: -10px;
    right: 1rem;
  }

  h3 {
    font-size: 1.1rem;
  }

  .meta {
    font-size: 0.78rem;
    margin-bottom: 0.5rem;
  }

  .desc {
    font-size: 0.9rem;
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .links {
    border-top: 1px solid var(--border-soft);
    padding-top: 0.75rem;
    font-size: 0.8rem;
  }
</style>
